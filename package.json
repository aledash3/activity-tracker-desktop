{
  "name": "activity-tracker-desktop",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "David Alejandro Cruz Palacios",
    "email": "cruzd2249@gmail.com",
    "url": "https://github.com/aledash3"
  },
  "license": "MIT",
  "description": "Native desktop application for work and research activity tracking, weekly hour quotas, custom typography themes, and executive PDF/CSV report generation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aledash3/activity-tracker-desktop.git"
  },
  "homepage": "https://github.com/aledash3/activity-tracker-desktop#readme",
  "bugs": {
    "url": "https://github.com/aledash3/activity-tracker-desktop/issues"
  },
  "keywords": [
    "activity-tracker",
    "timesheet",
    "time-tracking",
    "electron",
    "react",
    "vite",
    "pdf-reports",
    "productivity",
    "desktop-app",
    "windows"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --port 5173 --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "desktop:pack": "vite build && electron-builder --dir",
    "desktop:dist": "vite build && electron-builder --win nsis portable",
    "build:exe": "npm run desktop:dist"
  },
  "build": {
    "appId": "com.aledash3.activitytracker",
    "productName": "Bitácora de Actividades",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bitácora de Actividades",
      "uninstallDisplayName": "Desinstalar Bitácora de Actividades"
    }
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.7.1",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "wait-on": "^8.0.4"
  }
}
